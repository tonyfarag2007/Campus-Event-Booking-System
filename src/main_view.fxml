<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Button?>

<TabPane fx:id="main_tab_pane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MainController">
    <tabs>
        <Tab text="User Management">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="570.0" prefWidth="800.0">
                    <children>
                        <!-- Resized table to width 500 to make room for the form -->
                        <TableView fx:id="user_table_view" layoutX="14.0" layoutY="14.0" prefHeight="540.0" prefWidth="500.0">
                            <columns>
                                <TableColumn fx:id="user_id_column" prefWidth="75.0" text="User ID" />
                                <TableColumn fx:id="user_name_column" prefWidth="150.0" text="Name" />
                                <TableColumn fx:id="user_email_column" prefWidth="175.0" text="Email" />
                                <TableColumn fx:id="user_type_column" prefWidth="100.0" text="Type" />
                            </columns>
                        </TableView>

                        <!--
                            Input form using GridPane.
                            Source: Bro Code "JavaFX GridPane", "JavaFX TextField", "JavaFX ChoiceBox".
                        -->
                        <GridPane layoutX="530.0" layoutY="14.0" prefWidth="250.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="170.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Add New User" GridPane.columnSpan="2" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

                                <Label text="User ID:" GridPane.rowIndex="1" />
                                <TextField fx:id="user_id_input" promptText="e.g. U001" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Name:" GridPane.rowIndex="2" />
                                <TextField fx:id="user_name_input" promptText="Full Name" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Email:" GridPane.rowIndex="3" />
                                <TextField fx:id="user_email_input" promptText="Email Address" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Type:" GridPane.rowIndex="4" />
                                <ChoiceBox fx:id="user_type_choicebox" prefWidth="170.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Button fx:id="add_user_btn" mnemonicParsing="false" onAction="#handle_add_user" text="Add User" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="Event Management">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                    <children>
                        <Label layoutX="20.0" layoutY="20.0" text="Event ListView stuff goes here" />
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="Booking System">
            <content>
                <AnchorPane prefHeight="570.0" prefWidth="800.0">
                    <children>

                        <!--
                            Booking TableView
                            Mirrors layout style of User Management and Waitlist tabs.
                        -->
                        <TableView fx:id="booking_table_view"
                                   layoutX="14.0"
                                   layoutY="14.0"
                                   prefHeight="540.0"
                                   prefWidth="500.0">

                            <columns>
                                <TableColumn fx:id="booking_id_column" prefWidth="90.0" text="Booking ID"/>
                                <TableColumn fx:id="booking_user_column" prefWidth="100.0" text="User ID"/>
                                <TableColumn fx:id="booking_event_column" prefWidth="100.0" text="Event ID"/>
                                <TableColumn fx:id="booking_time_column" prefWidth="120.0" text="Created At"/>
                                <TableColumn fx:id="booking_status_column" prefWidth="90.0" text="Status"/>
                            </columns>
                        </TableView>

                        <!--
                            Booking Action Form
                            Structured identically to User and Waitlist forms for UI consistency.
                        -->
                        <GridPane layoutX="530.0"
                                  layoutY="14.0"
                                  prefWidth="250.0"
                                  vgap="10.0">

                            <columnConstraints>
                                <ColumnConstraints prefWidth="80.0"/>
                                <ColumnConstraints prefWidth="170.0"/>
                            </columnConstraints>

                            <children>

                                <Label text="Booking Actions"
                                       GridPane.columnSpan="2"
                                       style="-fx-font-weight: bold; -fx-font-size: 14px;" />

                                <Label text="Booking ID:" GridPane.rowIndex="1"/>
                                <TextField fx:id="booking_id_input"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>

                                <Label text="User ID:" GridPane.rowIndex="2"/>
                                <TextField fx:id="booking_user_input"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>

                                <Label text="Event ID:" GridPane.rowIndex="3"/>
                                <TextField fx:id="booking_event_input"
                                           GridPane.columnIndex="1"
                                           GridPane.rowIndex="3"/>

                                <Button fx:id="add_booking_btn"
                                        text="Create Booking"
                                        onAction="#handle_add_booking"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="4"/>

                                <Button fx:id="cancel_booking_btn"
                                        text="Cancel Booking"
                                        onAction="#handle_cancel_booking"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="5"/>

                                <Label fx:id="booking_status_message"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="6"/>

                            </children>
                        </GridPane>

                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <Tab text="Waitlist Management">
            <content>
                <AnchorPane prefHeight="570.0" prefWidth="800.0">
                    <children>

                        <!-- Waitlist Table -->
                        <TableView fx:id="waitlist_table_view"
                                   layoutX="14.0"
                                   layoutY="14.0"
                                   prefHeight="540.0"
                                   prefWidth="500.0">

                            <columns>
                                <TableColumn fx:id="waitlist_booking_id_column" prefWidth="90.0" text="Booking ID"/>
                                <TableColumn fx:id="waitlist_user_column" prefWidth="100.0" text="User ID"/>
                                <TableColumn fx:id="waitlist_event_column" prefWidth="100.0" text="Event ID"/>
                                <TableColumn fx:id="waitlist_time_column" prefWidth="120.0" text="Created At"/>
                                <TableColumn fx:id="waitlist_status_column" prefWidth="90.0" text="Status"/>
                            </columns>
                        </TableView>

                        <!-- Waitlist Actions -->
                        <GridPane layoutX="530.0"
                                  layoutY="14.0"
                                  prefWidth="250.0"
                                  vgap="10.0">

                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="80.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="170.0"/>
                            </columnConstraints>

                            <rowConstraints>
                                <RowConstraints prefHeight="30.0"/>
                                <RowConstraints prefHeight="30.0"/>
                                <RowConstraints prefHeight="30.0"/>
                                <RowConstraints prefHeight="30.0"/>
                            </rowConstraints>

                            <children>

                                <Label text="Waitlist Actions"
                                       GridPane.columnSpan="2"
                                       style="-fx-font-weight: bold; -fx-font-size: 14px;" />

                                <Button fx:id="remove_waitlist_btn"
                                        text="Remove from Waitlist"
                                        onAction="#handle_remove_waitlist"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"/>

                                <Button fx:id="refresh_waitlist_btn"
                                        text="Refresh Waitlist"
                                        onAction="#handle_refresh_waitlist"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="2"/>

                                <Label fx:id="waitlist_status_message"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="3"
                                       style="-fx-text-fill: green;"/>

                            </children>
                        </GridPane>

                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>